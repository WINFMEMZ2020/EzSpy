<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grabber_glow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ezspy_mark" />
        </FrameLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grabButton"
            style="@style/Widget.EzSpy.Button"
            android:layout_width="244dp"
            android:layout_height="56dp"
            android:text="@string/grab_start"
            app:icon="@drawable/ic_crosshair" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/grab_hint"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
