<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Material Design 2 theme (Android 8.0 – 11 style).
      Black/gray surfaces with a purple accent, following the system light/dark setting.
    -->
    <style name="Theme.EzSpy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_primary_variant</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.EzSpy.Button</item>
        <item name="tabStyle">@style/Widget.EzSpy.TabLayout</item>
        <item name="toolbarStyle">@style/Widget.EzSpy.Toolbar</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- Theme used when inflating the floating preview panel. -->
    <style name="Theme.EzSpy.Overlay" parent="Theme.EzSpy">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="TextAppearance.EzSpy.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.EzSpy.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.EzSpy.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/color_surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.EzSpy.ToolbarTitle</item>
    </style>

    <style name="Widget.EzSpy.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/color_surface</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorColor">@color/color_accent</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabSelectedTextColor">@color/color_accent</item>
        <item name="tabTextColor">@color/color_text_secondary</item>
        <item name="tabRippleColor">@color/color_accent_ripple</item>
        <item name="tabTextAppearance">@style/TextAppearance.EzSpy.Tab</item>
    </style>

    <style name="Widget.EzSpy.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/color_button_text</item>
        <item name="backgroundTint">@color/color_button_bg</item>
        <item name="iconTint">@color/color_button_text</item>
        <item name="iconPadding">10dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
